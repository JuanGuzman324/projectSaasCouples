# Copia este archivo a .env.local y pon los datos de tu proyecto Supabase
# (Project Settings > API). Nunca subas .env.local a git.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Clave pública VAPID para notificaciones push (BACKLOG P3). La privada NUNCA
# va aquí: vive solo como secret de la Edge Function (supabase secrets set).
# Genera el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY

# Clave de sitio (pública) de Cloudflare Turnstile, para el captcha de
# Login/Registro (BACKLOG P0 legal). La secreta NUNCA va aquí: vive como
# env(SUPABASE_AUTH_CAPTCHA_SECRET) para "supabase config push" (ver
# README, sección "CAPTCHA en Login/Registro"). Sin esta variable, el
# widget simplemente no se muestra — útil en desarrollo local.
VITE_TURNSTILE_SITE_KEY=TU_TURNSTILE_SITE_KEY

# Muestra el botón "Continuar con Google" en Login/Registro. No es una
# credencial (no hay ninguna clave de Google acá — el client_id/secret de
# Google viven solo en supabase/config.toml y en el proyecto Supabase real,
# nunca en el cliente); es solo un interruptor para no ofrecer un botón
# que fallaría antes de que el provider esté activado. Ver README, sección
# "Login con Google".
VITE_GOOGLE_AUTH_ENABLED=false
